# 复制此文件为 .env 并填入你自己的 Key
# 通义千问（DashScope）示例（https://dashscope.aliyuncs.com/）
# 也支持 DeepSeek、智谱 GLM、Kimi 等 OpenAI 兼容接口，只需修改 BASE_URL 与 MODEL。
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-turbo

# ===== 输出预算与思考模式（重要）=====
# 混合思考模型（qwen3.5+/qwen3.7-flash/qwen3.8、GLM-5 等）默认开启「思考」，
# 思考内容与正文共享 max_tokens 预算。预算不足时会出现
# 「HTTP 200 但 content 为空」→ 日志报 JSON 解析失败
# `Expecting value: line 1 column 1 (char 0)`。
#
# LLM_DISABLE_THINKING=1（默认）会自动关闭思考模式（DashScope 发 enable_thinking=false，
# DeepSeek 官方端点发 thinking={"type":"disabled"}，其它端点自动跳过该参数）：
#   更快、更省 token，适合档案提取这类「按格式输出」的任务。
# 设为 0 可恢复思考模式（推理质量更好），但请同时把 LLM_MAX_TOKENS 调到 8192 以上。
LLM_DISABLE_THINKING=1

# 单次回复的最大 token 预算。档案提取要输出 core_thought(500字) 等长字段，
# 建议不低于 4096；开思考模式时建议 8192 以上。
LLM_MAX_TOKENS=4096

# 采样温度（不填默认 0.7；档案提取等严肃任务内部固定用 0.2）
# LLM_TEMPERATURE=0.7

# 调试模式
DEBUG=0
